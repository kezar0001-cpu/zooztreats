# ---------------------------------------------------------------------------
# Zooz Treats — Environment variables
# Copy this file to `.env.local` and fill in the values from your Supabase
# project (Project Settings → API).
# ---------------------------------------------------------------------------

# Public Supabase project URL, e.g. https://abcdefghijklmno.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public anon/publishable key (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Comma-separated list of admin emails allowed into the /admin area.
# Any logged-in user whose email is NOT in this list is blocked.
# Example: ADMIN_EMAILS=owner@zooztreats.com,manager@zooztreats.com
ADMIN_EMAILS=

# Name of the Supabase Storage bucket used for product images.
# Defaults to "product-images" if not set.
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=product-images

# ---------------------------------------------------------------------------
# Server-only secrets — NEVER prefix these with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# Supabase service role key (Project Settings → API → service_role).
# Used only by server-side checkout + Stripe webhook to write orders.
# Must never be exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe secret key (test mode), e.g. sk_test_...
STRIPE_SECRET_KEY=

# Stripe webhook signing secret, e.g. whsec_...
# From `stripe listen` (local) or the Stripe Dashboard webhook endpoint.
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Public Stripe / site config
# ---------------------------------------------------------------------------

# Stripe publishable key (test mode), e.g. pk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Public base URL used to build Stripe success/cancel URLs.
# Local: http://localhost:3000 — Vercel: https://your-domain.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
